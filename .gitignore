# 비밀값 — 절대 커밋 금지
.env
.env.*
!.env.example

# 에이전트/오케스트레이터 런타임 상태 — 재현 가능한 제품 산출물이 아님
.claude/
.codex/
.omc/
.omx/
.unlazy/
.unlazy-hook-state.json

# 외부 저장소 클론 — 커밋 금지
vendor/

# 빌드/캐시
node_modules/
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# playwright MCP 실행 찌꺼기
.playwright-mcp/

# 디자인 레퍼런스 스크린샷 드롭 — 커밋 금지
/toss-*.png
/audit-*.png
/paper-*.png
/app/design-references/

# 로컬 실행 증거(스윕 덤프·프로브 출력·핸드오프 키트·.bak) — 재현 가능하므로 커밋 금지
/artifacts/

# npm 패키지 내려받기 찌꺼기 — 의존성은 package.json이 소유한다
/package/
/*.tgz

# QA eval-run artifacts (screenshots/observations) - not for commit
datasets/eval-runs/

# Provider 검증/벤치마크 실행 산출물 — 실행마다 달라지는 로컬 증거.
/artifacts/provider-session-benchmark/*.json
/artifacts/provider-sessions/*.json

# Dest keep-set: this public remote only tracks run/rebuild + dest-control paths.
# scripts/security/keepset.mjs is the fail-closed checker; these rules stop git add.
/*
!/.gitignore
!/.gitattributes
!/.githooks/
!/.githooks/**
!/.github/
!/.github/workflows/
!/.github/workflows/secret-scan.yml
!/README.md
!/GROK.md
!/AGENTS.md
!/CLAUDE.md
!/scripts/
/scripts/*
!/scripts/security/
!/scripts/security/**
!/scripts/build-windows-installer.ps1
!/scripts/windows-installer.config.cjs
!/app/
/app/*
!/app/main.js
!/app/preload.js
!/app/shell.html
!/app/shell.js
!/app/shell.css
!/app/canvas.js
!/app/canvas.css
!/app/chat.js
!/app/chat.css
!/app/orb.html
!/app/orb.js
!/app/orb.css
!/app/provider-first-paint.js
!/app/package.json
!/app/package-lock.json
!/app/lib/
!/app/lib/**
!/app/data/
!/app/data/**
!/app/styles/
!/app/styles/**
!/app/test-fixtures/
/app/test-fixtures/*
!/app/test-fixtures/provider-contract/
/app/test-fixtures/provider-contract/*
!/app/test-fixtures/provider-contract/decision.json
!/backend/
/backend/*
!/backend/pyproject.toml
!/backend/uv.lock
!/backend/athena_api/
!/backend/athena_api/**
!/backend/athena_mcp/
!/backend/athena_mcp/**
!/backend/ref/
!/backend/ref/**

# Re-ignore paths the installer staging filter also omits inside keep trees.
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.test.js
**/test/
**/tests/
