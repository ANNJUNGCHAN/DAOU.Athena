{
  "manifest_version": 3,
  "name": "ATHENA for Kiwoom WTS",
  "version": "0.8.0",
  "minimum_chrome_version": "116",
  "description": "키움 WTS 화면을 제어하고 로컬 PC에서 조회 전용 금융 카드를 표시합니다.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://wts.kiwoom.com/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "ATHENA WTS"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
