#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$ROOT/scripts/security/gitleaks.toml"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is required" >&2
  exit 1
fi
if [[ -f "$CONFIG" ]]; then
  gitleaks git "$ROOT" --redact=100 --no-banner -c "$CONFIG"
else
  gitleaks git "$ROOT" --redact=100 --no-banner
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is required for prompt-security markers" >&2
  exit 1
fi
node "$ROOT/scripts/security/check-prompt-security.mjs"

# Public remotes are intended. Refuse only if GitHub push protection is off.
if command -v gh >/dev/null 2>&1; then
  SCAN="$(gh api repos/:owner/:repo --jq '.security_and_analysis.secret_scanning_push_protection.status' 2>/dev/null || echo "")"
  if [[ -n "$SCAN" && "$SCAN" != "enabled" ]]; then
    echo "pre-push: GitHub secret_scanning_push_protection is '$SCAN', not enabled." >&2
    echo "Enable it on the public repo before pushing, or set ATHENA_SKIP_PUSH_PROTECTION_CHECK=1." >&2
    if [[ "${ATHENA_SKIP_PUSH_PROTECTION_CHECK:-}" != "1" ]]; then
      exit 1
    fi
  fi
fi
