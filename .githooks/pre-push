#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$ROOT/scripts/security/gitleaks.toml"

run_security_gates() {
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is required" >&2
  exit 1
fi
if [[ -f "$CONFIG" ]]; then
  gitleaks git "$ROOT" --redact=100 --no-banner -c "$CONFIG"
else
  gitleaks git "$ROOT" --redact=100 --no-banner
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is required for prompt-security markers and tracked-keepset" >&2
  exit 1
fi
node "$ROOT/scripts/security/check-tracked-keepset.mjs"
node "$ROOT/scripts/security/check-prompt-security.mjs"
node "$ROOT/scripts/security/check-public-artifacts.mjs" </dev/null

# This public repository requires a positively verified protection status.
if ! command -v gh >/dev/null 2>&1; then
  echo "pre-push: GitHub CLI is required to verify push protection." >&2
  exit 1
fi
if ! SCAN="$(gh api repos/:owner/:repo --jq '.security_and_analysis.secret_scanning_push_protection.status')"; then
  echo "pre-push: could not verify GitHub push protection; check authentication and connectivity." >&2
  exit 1
fi
if [[ "$SCAN" != "enabled" ]]; then
  echo "pre-push: GitHub push protection was not verified as enabled." >&2
  exit 1
fi
}

run_security_gates </dev/null
git lfs pre-push "$@"
