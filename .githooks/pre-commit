#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$ROOT/scripts/security/gitleaks.toml"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required (https://github.com/gitleaks/gitleaks)" >&2
  exit 1
fi
if [[ -f "$CONFIG" ]]; then
  gitleaks git "$ROOT" --pre-commit --staged --redact=100 --no-banner -c "$CONFIG"
else
  gitleaks git "$ROOT" --pre-commit --staged --redact=100 --no-banner
fi
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is required for tracked-keepset" >&2
  exit 1
fi
node "$ROOT/scripts/security/check-tracked-keepset.mjs"
node "$ROOT/scripts/security/check-prompt-security.mjs"
